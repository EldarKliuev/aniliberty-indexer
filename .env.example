# Host address for the server to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Port for the proxy server to listen on (default: 3649)
PORT=3649

# AniLiberty API Configuration
ANILIBERTY_API=https://anilibria.top/api/v1
ANILIBERTY_SITE=https://anilibria.top

# Optional: API Key to secure Torznab endpoints (empty = authentication disabled)
API_KEY=

# Optional: HTTP/HTTPS or SOCKS5 proxy URL for outbound AniLiberty API calls
UPSTREAM_PROXY=

# Optional: Custom template for torrent titles
# Available placeholders:
#   {title_latin_clean} - Cleaned original latin/romaji name (e.g. "Monogatari Series")
#   {title_latin}       - Raw original latin/romaji name (e.g. "Monogatari Series: Second Season")
#   {title_ru}          - Russian name (e.g. "Цикл Историй: Второй Сезон")
#   {season}            - Season number (e.g. "2")
#   {episodes}          - Episodes extracted from the torrent description (e.g. "E01-E23" or "E01")
#   {season_episodes}   - Season and episodes extracted from the torrent description (e.g. "S02E01-S02E23", "S02E01" or "S02")
#   {year}              - Release year (e.g. "2013")
#   {type}              - Source type (e.g. "WEBRip")
#   {quality}           - Resolution (e.g. "1080p")
#   {codec}             - Normalized codec (e.g. "x264")
# Default: [AniLiberty] {title_latin_clean} - S{season} [RUS][{type} {quality} {codec}] ({year})
# Note: If the template contains unknown placeholders or mismatched braces, validation will fail on startup
TORRENT_TITLE_TEMPLATE=
TORRENT_MOVIE_TITLE_TEMPLATE=

# Optional: Rewrite .torrent download URLs to local /download/{hash} endpoint (true/false, default: false)
PROXY_DOWNLOADS=false

# Optional: Base URL of this indexer for proxy downloads (e.g. https://aniliberty-indexer.domain.com, http://localhost:3649)
BASE_URL=

# Optional: Resolve TVDB season/episode numbering via MAL IDs (true/false, default: true)
# Uses the Fribb/anime-lists dataset to map AniLiberty releases to TheTVDB seasons
SEASON_MAPPING=true

# Optional: Source of the MAL -> TVDB mapping list
# Default: https://raw.githubusercontent.com/Fribb/anime-lists/master/anime-list-full.json
MAPPING_URL=

# Optional: How often to re-download the mapping list, in hours (default: 24)
MAPPING_REFRESH_HOURS=

# Optional: How often to re-crawl the AniLiberty catalog for tvdbid searches, in hours (default: 6)
CATALOG_REFRESH_HOURS=

# Optional: Directory for the cached mapping list (default: ./data, /data in Docker; empty = no disk cache)
# DATA_DIR=

# Optional: qBittorrent WebUI URL; enables renaming AniLiberty episode files to SxxEyy
# so that Sonarr imports season packs mapped to TVDB seasons (empty = disabled)
QBIT_URL=

# Optional: qBittorrent WebUI credentials (leave empty if auth is bypassed for the indexer)
QBIT_USERNAME=
QBIT_PASSWORD=

# Optional: Only check torrents in this qBittorrent category (empty = all torrents)
QBIT_CATEGORY=

# Optional: How often to check qBittorrent torrents, in seconds (default: 60)
QBIT_RENAME_INTERVAL=
